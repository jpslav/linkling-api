__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
.venv-*/

# Linked git worktrees an agent session made for itself: checkouts of this
# same repo, not its content. Untracked, they also stop tools/sync-repos.sh
# fast-forwarding this checkout, because the tree reads as dirty.
.claude/worktrees/

# A dispatched worker's own checklist, and the SQLite database the service
# writes when you run it locally (`LINKLING_DB`, README "Run it locally").
.goal
data/
*.db
*.db-wal
*.db-shm

# The team key (LINKLING_API_KEY) goes in a .env beside compose.yaml, and never into git.
.env

# The throwaway data directories scripts/compose-smoke.sh creates, one per run.
.smoke-data/
